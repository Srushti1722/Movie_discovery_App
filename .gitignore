# ==============================================================================
# Node.js & React (Vite) Comprehensive .gitignore
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment Variables — NEVER COMMIT SECRETS
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
# Ensure example files ARE committed (don't ignore them)
!.env.example

# Build Outputs (Frontend & Backend)
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# Vite specific
.vite/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
.nyc_output

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDEs and Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history
