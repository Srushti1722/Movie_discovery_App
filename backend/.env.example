# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# MongoDB connection string
# For local development: mongodb://localhost:27017/movie-discovery
# For MongoDB Atlas:     mongodb+srv://<user>:<password>@cluster.mongodb.net/movie-discovery
MONGODB_URI=mongodb://localhost:27017/movie-discovery

# TMDB API key — get yours free at https://www.themoviedb.org/settings/api
# This key must NEVER be sent to the frontend.
TMDB_API_KEY=your_tmdb_api_key_here

# TMDB base URL (rarely changes, but good practice to make it configurable)
TMDB_BASE_URL=https://api.themoviedb.org/3

# Port the Express server will listen on
PORT=5000

# Allowed frontend origin for CORS
# In development this is your Vite dev server
# In production this would be your deployed frontend URL
FRONTEND_URL=http://localhost:5173
